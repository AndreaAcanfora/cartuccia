22222222
22122222
22222212
22222222
12222222
22222222
]]

const CARS = 16
const LANES = 6
const LANEY = 24
const STARTY = 124

-- which lane each car is in, and its distance from the lane's start
const carlane: u8[] = {0, 0, 0, 1, 1, 2, 2, 2, 3, 3, 4, 4, 4, 5, 5, 5}
const caroff: u8[] = {0, 90, 170, 20, 140, 40, 110, 200, 60, 190, 10, 80, 160, 30, 120, 210}
-- speed of each lane in 1/256 pixel per frame at level 1, and its direction
const lanespd: u16[] = {150, 230, 120, 280, 180, 220}
const lanedir: u8[] = {0, 1, 0, 1, 0, 1}

var lanepos: u16[6]
var speed: u16[6]

var fx = 76
var fy = 124
var best = 124
var lives = 3
var level = 1
var score: u16 = 0
var dead = 0
var won = 0
var playing = false
var over = false

function drawfield()
  for c = 0, 19 do
    tile(c, 1, goal)
    tile(c, 2, goal)
    for r = 3, 14 do
      if r % 2 == 0 and r < 14 then
        tile(c, r, dash)
      else
        tile(c, r, road)
      end
    end
    tile(c, 15, grass)
    tile(c, 16, grass)
  end
end

function hud()
  num(6, 0, level)
  num(18, 0, lives)
  num(6, 17, score)
end

function setlevel()
  for l = 0, LANES - 1 do
    -- a quarter faster each level, up to level 12
    speed[l] = lanespd[l] * u16(min(level, 12) + 3) / 4
  end
end

function resetfrog()
  fx = 76
  fy = STARTY
  best = STARTY
  dead = 0
  won = 0
end

function start()
  cls()
  drawfield()
  text(0, 0, "LEVEL")
  text(12, 0, "LIVES")
  text(0, 17, "SCORE")
  level = 1
  lives = 3
  score = 0
  over = false
  playing = true
  setlevel()
  hud()
  resetfrog()
end

function _init()
  cls()
  text(5, 5, "FROG ROAD")
  tile(9, 7, frog)
  text(3, 10, "CROSS THE ROAD")
  text(6, 12, "3 LIVES")
  text(4, 14, "PRESS START")
  for l = 0, LANES - 1 do
    lanepos[l] = u16(rnd(0)) << 8
    speed[l] = lanespd[l]
  end
end

function cars()
  for l = 0, LANES - 1 do
    if lanedir[l] == 1 then
      lanepos[l] += speed[l]
    else
      lanepos[l] -= speed[l]
    end
  end
  for j = 0, CARS - 1 do
    local l = carlane[j]
    local x = u8(lanepos[l] >> 8) + caroff[j]
    local y = LANEY + l * 16 + 4
    local t = carl
    if lanedir[l] == 1 then t = carr end
    if l == 1 or l == 5 then t = truck end
    spr(1 + j * 2, x, y, t)
    spr(2 + j * 2, x + 8, y, t + 1)
    -- the frog touches the car (wrapping around the 256-pixel lane)
    if playing and dead == 0 and fy == y then
      local d = fx + 6 - x
      if d < 20 then die() end
    end
  end
end

function die()
  dead = 60
  noise(6)
end

function afterdeath()
  lives -= 1
  hud()
  if lives == 0 then
    over = true
    playing = false
    hide(0)
    text(5, 1, "GAME OVER")
    text(4, 2, "PRESS START")
  else
    resetfrog()
  end
end

function hop()
  if btnp(UP) and fy > 12 then
    fy -= 16
    beep(30, 1)
  elseif btnp(DOWN) and fy < STARTY then
    fy += 16
    beep(26, 1)
  elseif btnp(LEFT) and fx >= 8 then
    fx -= 8
    beep(28, 1)
  elseif btnp(RIGHT) and fx <= 144 then
    fx += 8
    beep(28, 1)
  end
  if fy < best then
    best = fy
    score += 10
    hud()
  end
  if fy == 12 then
    -- made it across: next level, faster cars
    score += 50 * u16(level)
    level += 1
    setlevel()
    hud()
    beep(36, 4)
    won = 45
    text(4, 16, "SAFE! LEVEL")
    num(16, 16, level)
  end
end

function _update()
  if playing or over then cars() end
  if not playing then
    if btnp(START) or btnp(A) then start() end
    return
  end
  if dead > 0 then
    dead -= 1
    spr(0, fx, fy, splat)
    if dead == 0 then afterdeath() end
    return
  end
  if won > 0 then
    -- a moment on the far side before the next, faster crossing
    won -= 1
    if won == 0 then
      for c = 4, 19 do tile(c, 16, grass) end
      resetfrog()
    end
  else
    hop()
  end
  spr(0, fx, fy, frog)
end
