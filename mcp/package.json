{
  "name": "cartuccia-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude and other AI agents write, run and playtest Game Boy games in cartuccia",
  "license": "MIT",
  "author": "Andrea Acanfora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreaAcanfora/cartuccia.git",
    "directory": "mcp"
  },
  "homepage": "https://andreaacanfora.github.io/cartuccia/",
  "keywords": [
    "mcp",
    "game-boy",
    "gameboy",
    "compiler",
    "emulator",
    "claude",
    "gamedev"
  ],
  "type": "module",
  "bin": {
    "cartuccia-mcp": "src/index.js"
  },
  "files": [
    "src",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets": "node scripts/assets.js",
    "test": "node --test test/*.test.js",
    "prepack": "node scripts/assets.js && cp ../LICENSE LICENSE"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.0"
  },
  "mcpName": "io.github.AndreaAcanfora/cartuccia"
}
